# Copy to .env (cp .env.example .env) and fill in. .env is git-ignored. Never commit a real key.

# --- the three values that pick the provider ---
# OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1   LLM_MODEL=openrouter/free   LLM_API_KEY=<your OpenRouter key>
# Ollama:     LLM_BASE_URL=http://localhost:11434/v1/     LLM_MODEL=gemma3:1b         LLM_API_KEY=ollama
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- switches ---
LLM_STUB=            # 1 = return a fixed fake answer, no model call (build and debug for free)
LLM_ENABLED=true     # false = kill switch: deterministic fallback, no model call

# --- tuning (optional; defaults shown) ---
# LLM_TIMEOUT_MS=30000
# LLM_MAX_ATTEMPTS=3
# LLM_RETRY_BASE_MS=1000
# PROMPT_VERSION=v1
# PORT=3000
